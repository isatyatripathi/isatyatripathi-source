{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devsignal.local/schemas/curated-items.schema.json",
  "title": "DevSignal curated content items",
  "type": "object",
  "required": [
    "schemaVersion",
    "items"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "url"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "sourceName": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "summary": {
            "type": "string",
            "maxLength": 5000
          },
          "content": {
            "type": "string",
            "maxLength": 20000
          },
          "author": {
            "type": "string",
            "maxLength": 300
          },
          "publishedAt": {
            "type": "string",
            "format": "date-time"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 50
          },
          "notes": {
            "type": "string",
            "maxLength": 5000
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
