    {
      "id": "stackexchange-targeted",
      "name": "Stack Overflow targeted questions",
      "connectorType": "stackexchange",
      "endpoint": "https://api.stackexchange.com/2.3/questions",
      "enabled": true,
      "trustWeight": 0.7,
      "defaultTags": [
        "stackoverflow",
        "community",
        "questions"
      ],
      "pollMinutes": 1440,
      "maxItemsPerRun": 40,
      "connectorSettings": {
        "site": "stackoverflow",
        "tagged": "c#;.net;asp.net-core;reactjs;azure;docker;large-language-model",
        "sort": "activity",
        "order": "desc",
        "filter": "default"
      },
      "complianceNotes": "Use the documented Stack Exchange API and honor backoff/quota fields."
    },
    {
