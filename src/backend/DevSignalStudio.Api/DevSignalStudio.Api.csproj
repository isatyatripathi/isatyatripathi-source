<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>DevSignalStudio.Api</RootNamespace>
    <AssemblyName>DevSignalStudio.Api</AssemblyName>
    <UserSecretsId>devsignal-studio-local</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DevSignalStudio.Application\DevSignalStudio.Application.csproj" />
    <ProjectReference Include="..\DevSignalStudio.Domain\DevSignalStudio.Domain.csproj" />
    <ProjectReference Include="..\DevSignalStudio.Infrastructure\DevSignalStudio.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\..\config\**\*">
      <Link>config\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\..\data\.gitkeep">
      <Link>data\.gitkeep</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
